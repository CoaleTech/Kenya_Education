{
 "doctype": "DocType",
 "name": "Scheduled Message",
 "module": "Frappe Education Kenya",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": [
  "audience",
  "filters",
  "body",
  "send_at",
  "status",
  "recipients"
 ],
 "fields": [
  {
   "fieldname": "audience",
   "fieldtype": "Select",
   "label": "Audience",
   "options": "Class\nFees Balance\nGuardian List",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "filters",
   "fieldtype": "Code",
   "label": "Filters",
   "options": "JSON",
   "reqd": 1,
   "description": "Class: {\"student_group\":\"...\"}; Fees Balance: {\"minimum_balance\":1,\"company\":\"...\"}; Guardian List: {\"guardians\":[\"...\"]}"
  },
  {
   "fieldname": "body",
   "fieldtype": "Small Text",
   "label": "Body",
   "reqd": 1
  },
  {
   "fieldname": "send_at",
   "fieldtype": "Datetime",
   "label": "Send At",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nScheduled\nSending\nSent\nFailed",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "recipients",
   "fieldtype": "Table",
   "label": "Recipients",
   "options": "Message Recipient",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Bursar",
   "read": 1,
   "report": 1,
   "export": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Head Teacher",
   "read": 1,
   "report": 1,
   "export": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Academic Admin",
   "read": 1,
   "report": 1,
   "export": 1,
   "write": 1,
   "create": 1
  }
 ],
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC"
}
