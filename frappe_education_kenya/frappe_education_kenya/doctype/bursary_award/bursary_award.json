  {
   "role": "Bursar",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "permlevel": 0
  },
  {
   "role": "Head Teacher",
   "read": 1,
   "write": 1,
   "create": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "permlevel": 0
  },
  {
   "role": "Guardian",
   "read": 1,
   "write": 0,
   "create": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "permlevel": 0
  }
 ],
