 "fields": [
  {
   "fieldname": "copy",
   "fieldtype": "Link",
   "label": "Copy",
   "options": "Library Copy",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "borrower_type",
   "fieldtype": "Select",
   "label": "Borrower Type",
   "options": "Student\nEmployee",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "borrower",
   "fieldtype": "Dynamic Link",
   "label": "Borrower",
   "options": "borrower_type",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "issued_on",
   "fieldtype": "Datetime",
   "label": "Issued On",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "due_on",
   "fieldtype": "Date",
   "label": "Due On",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "returned_on",
   "fieldtype": "Datetime",
   "label": "Returned On",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Issued\nReturned",
   "default": "Issued",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "fine_amount",
   "fieldtype": "Currency",
   "label": "Fine Amount",
   "options": "currency",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "fine_status",
   "fieldtype": "Select",
   "label": "Fine Status",
   "options": "None\nPending\nWaived\nInvoiced",
   "default": "None",
   "permlevel": 1,
   "read_only": 1
  },
  {
   "fieldname": "fine_invoice",
   "fieldtype": "Link",
   "label": "Fine Invoice",
   "options": "Sales Invoice",
   "read_only": 1,
   "permlevel": 1
  },
  {
   "fieldname": "waiver_reason",
   "fieldtype": "Small Text",
   "label": "Waiver Reason",
   "read_only": 1,
   "permlevel": 1,
   "depends_on": "eval:doc.fine_status==\"Waived\""
  },
  {
   "fieldname": "waived_by",
   "fieldtype": "Link",
   "label": "Waived By",
   "options": "User",
   "read_only": 1,
   "permlevel": 1,
   "depends_on": "eval:doc.fine_status==\"Waived\""
  },
  {
   "fieldname": "issued_by",
   "fieldtype": "Link",
   "label": "Issued By",
   "options": "User",
   "read_only": 1
  }
 ],
