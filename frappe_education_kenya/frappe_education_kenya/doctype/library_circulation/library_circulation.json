{
 "doctype": "DocType",
 "name": "Library Circulation",
 "module": "Frappe Education Kenya",
 "engine": "InnoDB",
 "field_order": [
  "copy",
  "borrower_type",
  "borrower",
  "issued_on",
  "due_on",
  "returned_on",
  "status",
  "currency",
  "fine_amount",
